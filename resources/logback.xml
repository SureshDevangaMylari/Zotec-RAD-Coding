<configuration>

    <!-- ========================= -->
    <!-- Console Appender -->
    <!-- Prints to console for development -->
    <!-- ========================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- File Appender with Date-wise Folders -->
    <!-- Keeps logs forever -->
    <!-- ========================= -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/current.log</file> <!-- default current log -->

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- logs go to date-wise folders -->
            <FileNamePattern>logs/%d{yyyy-MM-dd}/app.log</FileNamePattern>
            <!-- 0 = keep logs forever -->
            <maxHistory>0</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- Capture System.out / System.err -->
    <!-- ========================= -->
    <conversionRule conversionWord="msgColor" converterClass="ch.qos.logback.core.pattern.color.ForegroundCompositeConverterWrapper" />

    <appender name="SYSOUT_TO_LOG" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- Root Logger -->
    <!-- ========================= -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="SYSOUT_TO_LOG"/>
    </root>

</configuration>